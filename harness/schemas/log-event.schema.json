{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local://harness/log-event.schema.json",
  "title": "Local Harness Event",
  "type": "object",
  "required": ["schema_version", "event_id", "run_id", "sequence", "timestamp", "phase", "event_type", "task_id", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "phase": { "enum": ["start", "execute", "validate", "finalize", "resume"] },
    "event_type": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
